# Copy to .env.local for local Supabase/Gemini testing. Never commit real values.
# Leave Supabase blank to use the local JSON store in .data/ (dev/test only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: without a key the app uses its labelled rules fallback everywhere.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
